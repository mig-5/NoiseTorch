; NoiseTorch Virtual Audio Device (NT-VAD)
; Copyright (c) 2026 NoiseTorch-Windows contributors. GPL-3.0.
;
; Installs a root-enumerated PortCls virtual audio device that exposes a
; "NoiseTorch Virtual Microphone" capture endpoint and a matching render
; endpoint. The NoiseTorch Windows engine plays denoised audio into the render
; endpoint; the driver loops it to the capture endpoint.

[Version]
Signature="$WINDOWS NT$"
Class=MEDIA
ClassGuid={4d36e96c-e325-11ce-bfc1-08002be10318}
Provider=%ManufacturerName%
CatalogFile=NTVad.cat
DriverVer=01/01/2026,0.1.0.0
PnpLockdown=1

[DestinationDirs]
DefaultDestDir=12
NTVad.CopyList=12

[Manufacturer]
%ManufacturerName%=Standard,NT$ARCH$

[Standard.NT$ARCH$]
%NTVad.DeviceDesc%=NTVad_Device, Root\NTVad

[NTVad_Device.NT]
Include=wdmaudio.inf
Needs=WDMAudio_Device.NT
CopyFiles=NTVad.CopyList

[NTVad_Device.NT.Services]
Include=wdmaudio.inf
Needs=WDMAudio_Device.NT.Services
AddService=NTVad,0x00000002,NTVad_Service

[NTVad_Device.NT.HW]
Include=wdmaudio.inf
Needs=WDMAudio_Device.NT.HW

[NTVad_Service]
DisplayName=%NTVad.ServiceDesc%
ServiceType=1
StartType=3
ErrorControl=1
ServiceBinary=%12%\NTVad.sys
AddReg=NTVad_Service_AddReg

[NTVad_Service_AddReg]
HKR,,DebugLevel,0x00010001,0

[NTVad.CopyList]
NTVad.sys

[Strings]
ManufacturerName="NoiseTorch"
NTVad.DeviceDesc="NoiseTorch Virtual Audio Device"
NTVad.ServiceDesc="NoiseTorch Virtual Audio Device Driver"
